# The helper is read on a file descriptor rather than passed with -c: a
# single argument can't be longer than 128 KiB.
py() { python3 -I /dev/fd/3 "$@" 3<<<"$HELPER"; }
helper() { exec python3 -I /dev/fd/3 "$@" 3<<<"$HELPER"; }

need_nm() {
  local missing
  missing=$(missing_from "${REQUIRED[@]}")
  [[ -z $missing ]] || fail "Missing packages: $missing. Run setup to install."
  nm_running || fail "NetworkManager isn't running."
}

# nmcli -t and -g escape ":" and "\" inside values.
unescape() {
  local v=${1//\\:/:}
  printf '%s' "${v//\\\\/\\}"
}

# The first "Error: ..." line of nmcli's output, without the prefix.
nm_error() {
  local line
  line=$(grep -m1 '^Error: ' <<<"$1")
  line=${line#Error: }
  line=${line#Connection activation failed: }
  printf '%s' "${line:-$2}"
}

# Edit copies whose session was killed outright, so its EXIT trap never ran.
# Each folder is named after its session's pid.
sweep_edits() {
  local d pid
  [[ -d ${XDG_RUNTIME_DIR:-} ]] || return 0
  for d in "$XDG_RUNTIME_DIR"/omarchy-vpn-manager-edit.*; do
    [[ -d $d ]] || continue
    pid=${d##*/omarchy-vpn-manager-edit.}
    pid=${pid%%.*}
    [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && continue
    rm -rf -- "$d"
  done
}

cmd_status() {
  local missing active network line uuid type state dev file name ip secs sent recv now created copy place kind info addr
  local killswitch=0 run=${XDG_RUNTIME_DIR:-}
  local -a vpns=() in_memory=() unknown=()
  local -A profile=() profile_name=() hop=() iface_of=()
  sweep_edits
  missing=$(missing_packages)
  if ! installed; then
    printf 'installed\t0\nmissing\t%s\n' "$missing"
    return 0
  fi
  # It fails when NetworkManager isn't running.
  if ! active=$(nmcli -t -f UUID,TYPE,STATE,DEVICE,FILENAME,NAME connection show --active 2>/dev/null); then
    printf 'installed\t1\nmissing\t%s\nservice\tinactive\n' "$missing"
    return 0
  fi
  network=$(nmcli -t -f STATE general 2>/dev/null)
  while IFS= read -r line; do
    # Escaped backslashes and colons out of the way, so the fields split.
    line=${line//\\\\/$'\1'}
    line=${line//\\:/$'\2'}
    IFS=: read -r uuid type state dev file _ <<<"$line"
    [[ $type == dummy && ($dev == vpn-killswitch || $dev == wg-killswitch) && $state == activated ]] && killswitch=1
    [[ $type == wireguard || $type == vpn ]] || continue
    vpns+=("$line")
    # A chain connects copies of its profiles, which NetworkManager keeps in memory.
    [[ $file == /run/* ]] && in_memory+=("$uuid")
  done <<<"$active"
  printf 'installed\t1\nmissing\t%s\nopenvpn\t%s\nservice\tactive\nnetwork\t%s\nkillswitch\t%s\n' \
    "$missing" "$(openvpn_installed && echo 1 || echo 0)" "$network" "$killswitch"
  # What you disconnected, which isn't connected automatically again.
  if [[ -n $run && -r $run/omarchy-vpn-manager-held ]]; then
    while read -r uuid; do
      [[ -n $uuid ]] && printf 'held\t%s\n' "$uuid"
    done <"$run/omarchy-vpn-manager-held"
  fi
  # A chain's copies, as the connect noted them; the helper for any it didn't.
  if ((${#in_memory[@]})); then
    if [[ -n $run && -r $run/omarchy-vpn-manager-hops ]]; then
      while IFS=$'\t' read -r copy uuid name place; do
        profile[$copy]=$uuid profile_name[$copy]=$name hop[$copy]=$place
      done <"$run/omarchy-vpn-manager-hops"
    fi
    for copy in "${in_memory[@]}"; do
      [[ -n ${profile[$copy]:-} ]] || unknown+=("$copy")
    done
    if ((${#unknown[@]})); then
      while IFS=$'\t' read -r copy uuid name place; do
        profile[$copy]=$uuid profile_name[$copy]=$name hop[$copy]=$place
      done < <(py hops "${unknown[@]}" 2>/dev/null)
    fi
  fi
  # An OpenVPN connection's interface, by its address: NetworkManager names
  # the device it runs over instead.
  while read -r dev addr; do
    iface_of[${addr%/*}]=$dev
  done < <(ip -o addr show 2>/dev/null | awk '$3 == "inet" || ($3 == "inet6" && $0 ~ / scope global/) { print $2, $4 }')
  now=$(date +%s)
  for line in "${vpns[@]}"; do
    IFS=: read -r uuid type state dev file name <<<"$line"
    dev=${dev//$'\2'/:} name=${name//$'\2'/:}
    dev=${dev//$'\1'/\\} name=${name//$'\1'/\\}
    kind=wg ip=""
    if [[ $type == vpn ]]; then
      info=$(nmcli -t -f vpn.service-type,IP4.ADDRESS,IP6.ADDRESS connection show uuid "$uuid" 2>/dev/null) || continue
      [[ $info == *$'vpn.service-type:org.freedesktop.NetworkManager.openvpn'* ]] || continue
      kind=ovpn
      # An IPv6-only tunnel has no IPv4 address. nmcli escapes the colons.
      addr=$(sed -n 's/^IP4\.ADDRESS\[1\]://p' <<<"$info")
      [[ -n $addr ]] || addr=$(unescape "$(sed -n 's/^IP6\.ADDRESS\[1\]://p' <<<"$info")")
      ip=${addr%/*}
      dev=""
      [[ -n $ip ]] && dev=${iface_of[$ip]:-}
    fi
    place=""
    if [[ -n ${profile[$uuid]:-} ]]; then
      name=${profile_name[$uuid]} place=${hop[$uuid]} uuid=${profile[$uuid]}
    fi
    sent=0 recv=0 secs=""
    # The interface can go between any two of these, while disconnecting.
    if [[ -n $dev ]]; then
      if [[ $kind == wg ]]; then
        ip=$(ip -o -4 addr show dev "$dev" 2>/dev/null | awk '{ split($4, a, "/"); print a[1]; exit }')
        [[ -n $ip ]] || ip=$(ip -o -6 addr show dev "$dev" scope global 2>/dev/null | awk '{ split($4, a, "/"); print a[1]; exit }')
      fi
      read -r sent 2>/dev/null <"/sys/class/net/$dev/statistics/tx_bytes" || sent=0
      read -r recv 2>/dev/null <"/sys/class/net/$dev/statistics/rx_bytes" || recv=0
      # NetworkManager creates the interface when it connects and deletes it
      # when it disconnects, so its age is the connection's.
      if created=$(stat -c %Y "/sys/class/net/$dev" 2>/dev/null); then
        secs=$((now - created))
        ((secs < 0)) && secs=0
      fi
    fi
    case $state in
      activated) state=connected ;;
      activating) state=connecting ;;
      deactivating) state=disconnecting ;;
    esac
    printf 'vpn\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$uuid" "$kind" "$state" "${name//$'\t'/ }" "$ip" "$dev" "$sent" "$recv" "$secs" "$place"
  done
  return 0
}

cmd_candidates() {
  local dir=${1:-$HOME/Downloads} mtime path
  dir=${dir/#\~/$HOME}
  [[ -d $dir ]] || return 0
  # -H: the folder itself may be a symlink (to another drive, say). find
  # rounds sizes up to whole units, so this is 2 MiB or less, as import allows.
  find -H "$dir" -maxdepth 2 -type f \( -iname '*.conf' -o -iname '*.ovpn' \) -size -2049k -printf '%T@\t%p\n' 2>/dev/null |
    sort -rn | head -n 200 |
    while IFS=$'\t' read -r mtime path; do
      # Only files that look like a WireGuard or OpenVPN client profile.
      if grep -qsiE $'^(\xef\xbb\xbf)?[[:space:]]*\\[Interface\\]' "$path" && grep -qsi '^[[:space:]]*PrivateKey[[:space:]]*=' "$path"; then
        printf '%s\twg\t%s\n' "${mtime%.*}" "$path"
      elif grep -qsE '^[[:space:]]*(remote|client)([[:space:]]|$)' "$path"; then
        printf '%s\tovpn\t%s\n' "${mtime%.*}" "$path"
      fi
    done | head -n 20
  return 0
}

cmd_disconnect() {
  local uuid=${1:-} out u t plan failed=0
  need_nm
  if [[ -z $uuid ]]; then
    local -a forget=()
    # A chain first, innermost first.
    py disconnect >/dev/null || failed=1
    while IFS=: read -r u t; do
      [[ $t == wireguard || $t == vpn ]] || continue
      [[ $t == vpn && $(nmcli -g vpn.service-type connection show uuid "$u" 2>/dev/null) != org.freedesktop.NetworkManager.openvpn ]] && continue
      nmcli connection down uuid "$u" >/dev/null 2>&1 || failed=1
      forget+=(--forget "$u")
    done < <(nmcli -t -f UUID,TYPE connection show --active 2>/dev/null)
    # The kill switch stops letting their servers through.
    py sync-kill "${forget[@]}" || failed=1
    ((failed)) && fail "Couldn't disconnect everything."
    return 0
  fi
  # A profile in a chain takes the whole chain down with it.
  plan=$(py disconnect "$uuid") || exit 1
  [[ $plan == direct ]] || return 0
  out=$(LC_ALL=C nmcli connection down uuid "$uuid" 2>&1)
  # Already down is fine.
  if [[ $? -ne 0 && $out != *"not an active connection"* ]]; then
    fail "$(nm_error "$out" "Couldn't disconnect.")"
  fi
  py sync-kill --forget "$uuid"
}

# --- Editing a profile's config ---

# Yes/no in the terminal; without a terminal it's no.
ask() {
  [[ -t 0 && -t 1 ]] || return 1
  if command -v gum >/dev/null; then
    gum confirm "$1"
  else
    local reply
    read -rp "$1 [y/N] " reply && [[ $reply == [yY]* ]]
  fi
}

# Your Omarchy default editor when it runs in the terminal (and so can be
# waited for), otherwise Neovim. Each is started without your own config and
# plugins (an AI completion plugin would send a key away) and without swap,
# undo, history or backup files, so nothing in it is written to disk.
edit_file() {
  local editor=nvim
  [[ -f $HOME/.local/state/omarchy/defaults/editor ]] && read -r editor <"$HOME/.local/state/omarchy/defaults/editor"
  command -v "$editor" >/dev/null || editor=nvim
  case ${editor##*/} in
    vim) "$editor" --clean -n -i NONE "$1" ;;
    nano) "$editor" --ignorercfiles "$1" ;;
    micro) "$editor" -config-dir "$(dirname "$1")/micro" -backup false -savecursor false -saveundo false "$1" ;;
    *) nvim --clean -n "$1" ;;
  esac
}

cmd_edit() {
  local uuid=${1:-} dir file before out name
  [[ -n $uuid ]] || fail "No profile given."
  [[ -t 0 && -t 1 ]] || fail "Run in a terminal."
  need_nm
  sweep_edits
  umask 077
  # The runtime dir is in memory and yours alone; the copy goes when this ends.
  [[ -d ${XDG_RUNTIME_DIR:-} ]] || fail "No runtime folder to edit in."
  dir=$(mktemp -d "$XDG_RUNTIME_DIR/omarchy-vpn-manager-edit.$$.XXXXXX") || fail "Couldn't create folder to edit in."
  # Expanded now: the trap runs after this function's locals are gone.
  # shellcheck disable=SC2064
  trap "rm -rf $(printf %q "$dir")" EXIT
  file=$(py export "$uuid" "$dir") || return 1
  name=$(unescape "$(nmcli -g connection.id connection show uuid "$uuid" 2>/dev/null)")
  echo "Editing $name. Save and quit to apply; quit without saving to cancel."
  while true; do
    before=$(cksum <"$file")
    edit_file "$file"
    if [[ $(cksum <"$file") == "$before" ]]; then
      echo "No changes."
      return 0
    fi
    if out=$(py apply "$uuid" "$file" 2>&1); then
      echo "Saved $name."
      if [[ $(nmcli -g GENERAL.STATE connection show uuid "$uuid" 2>/dev/null) == activated ]] &&
        ask "$name is connected. Reconnect now to apply?"; then
        # Held meanwhile, so the panel doesn't take the moment it's down for
        # a drop and connect it too. An OpenVPN password not kept is asked
        # for here.
        # The kill switch lets its servers through as they are now.
        py hold "$uuid" 1
        if ! out=$(py sync-kill --for "$uuid" 2>&1); then
          echo "Couldn't reconnect: $out" >&2
        elif out=$(LC_ALL=C nmcli --ask connection up uuid "$uuid" 2>&1 >/dev/tty); then
          echo "Reconnected."
          py sync-kill
        else
          echo "Couldn't reconnect: $(nm_error "$out" "unknown error")" >&2
          py sync-kill --forget "$uuid"
        fi
        py hold "$uuid" 0
      fi
      return 0
    fi
    out=${out//"$file"/the file}
    echo "$out" >&2
    ask "Edit again?" || { echo "Nothing changed."; return 0; }
    # Keep the edits, with the reason at the end, where it doesn't move the
    # line it's about.
    { printf '\n'; sed 's/^/# /' <<<"$out"; } >>"$file"
  done
}

# --- Setup ---

# The bar section holding the widget, or nothing when it isn't in the bar.
bar_section() {
  jq -r --arg id "$PLUGIN_ID" '
    .bar.layout // {} | to_entries[] | select(any(.value[]?; .id == $id)) | .key
  ' "$HOME/.config/omarchy/shell.json" 2>/dev/null | head -n1
}

setup_placement() {
  local current section
  current=$(bar_section)
  if command -v gum >/dev/null; then
    section=$(printf '%s\n' left center right |
      gum choose --header="Which bar section for the VPN icon?" --selected "${current:-right}") || return 0
  else
    read -rp "Which bar section for the VPN icon? (left/center/right) [${current:-right}] " section
    section=${section:-${current:-right}}
  fi
  [[ $section =~ ^(left|center|right)$ ]] || return 0
  if [[ -z $current ]]; then
    omarchy plugin enable "$PLUGIN_ID" --section "$section"
  elif [[ $section != "$current" ]]; then
    omarchy bar move "$PLUGIN_ID" --section "$section" && echo "Icon moved to $section section."
  else
    echo "Icon stays in $section section."
  fi
}

cmd_setup() {
  local missing
  if ! [[ -t 0 && -t 1 ]]; then
    echo "Run in a terminal." >&2
    return 1
  fi
  mkdir -p "${OFFERED_FILE%/*}" && touch "$OFFERED_FILE"
  missing=$(missing_packages)
  if [[ -z $missing ]]; then
    echo "All required packages are installed."
  else
    echo "Missing packages: $missing"
    echo "  networkmanager          manages network connections, including VPNs"
    echo "  python-gobject          lets the plugin read and edit NetworkManager profiles"
    echo "  networkmanager-openvpn  OpenVPN support for NetworkManager (installs openvpn); not needed for WireGuard"
    echo "  wl-clipboard            pasting configs from the clipboard"
    if ask "Install $missing now? (requires your password)"; then
      # Word splitting is wanted: one argument per package.
      # shellcheck disable=SC2086
      omarchy pkg add $missing || echo "Install failed: $missing" >&2
    else
      echo "Skipped. Run setup again any time."
    fi
  fi
  nm_running || echo "NetworkManager isn't running."
  setup_placement
  return 0
}

# Once, the first time the plugin loads: offer setup in a notification,
# unless there's nothing to set up. Nothing changes unless it's clicked, and
# that opens a terminal where each step is asked about again.
cmd_offer_setup() {
  local self missing
  missing=$(missing_packages)
  [[ -n $missing ]] || return 0
  self=$(realpath "${BASH_SOURCE[0]}") || return 0
  # Created exclusively (noclobber), so when several reloads start this at
  # once only one of them gets past here.
  mkdir -p "${OFFERED_FILE%/*}" 2>/dev/null || return 0
  (set -C; : >"$OFFERED_FILE") 2>/dev/null || return 0
  # The plugin loads with the shell, which is also the notification server,
  # so give that a moment to come up. If it never does, or sending fails,
  # hand the marker back so the offer is made on a later load instead.
  for _ in {1..60}; do
    gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
      --method org.freedesktop.DBus.NameHasOwner org.freedesktop.Notifications 2>/dev/null | grep -q true && break
    sleep 0.5
  done
  # Omarchy's own click action, unlike a libnotify one, still works from the
  # notification history after this script has exited.
  omarchy-notification-send --app-name VPN -g 󰖂 -u normal "VPN needs setup" \
    "Click to install $missing and choose the icon's bar section. Or run setup from VPN panel later." \
    --exec omarchy-launch-floating-terminal-with-presentation "$(printf '%q' "$self") setup" >/dev/null ||
    rm -f "$OFFERED_FILE"
}

case "${1:-}" in
  status) cmd_status ;;
  candidates) cmd_candidates "${2:-}" ;;
  profiles | import | import-text | move | group | killswitch | save | remove | hold)
    need_nm
    helper "$@"
    ;;
  paste)
    need_nm
    command -v wl-paste >/dev/null || fail "Pasting needs wl-paste (wl-clipboard package). Run setup to install."
    # Straight from the clipboard into the helper: the config is never kept here.
    wl-paste --no-newline --type text 2>/dev/null | helper import-text --clipboard "${@:2}"
    ;;
  browse) helper browse "${@:2}" ;;
  connect)
    need_nm
    # One process: stopping it (the panel's Cancel) stops the connect.
    helper "$@"
    ;;
  disconnect) cmd_disconnect "${2:-}" ;;
  edit) cmd_edit "${2:-}" ;;
  setup) cmd_setup ;;
  offer-setup) cmd_offer_setup ;;
  *)
    echo "usage: vpn-nm status | profiles | import <file>... | import-text [name] | paste [name]" >&2
    echo "       vpn-nm candidates [dir] | browse [dir] | remove <uuid> | killswitch on|off" >&2
    echo "       vpn-nm save <uuid> <name> <autoconnect 1|0> [--via <uuid>] [--user-stdin] [--password save|ask] [--password-stdin] [--all-traffic 1|0]" >&2
    echo "       vpn-nm move <uuid> [[--above] <uuid>] | group <uuid> <name> [<autoconnect 1|0>]" >&2
    echo "       vpn-nm connect [--auto] <uuid> [--user-stdin] [--save|--ask] [--password-stdin] [--own-table] | disconnect [uuid]" >&2
    echo "       vpn-nm edit <uuid> | setup" >&2
    exit 1
    ;;
esac
